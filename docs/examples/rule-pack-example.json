{
  "id": "example-hr",
  "name": "Example HR records",
  "version": "1.0.0",
  "description": "Employee IDs, badge numbers and salaries",
  "author": "SafeRedact",
  "rules": [
    {
      "id": "employee-id",
      "name": "Employee ID",
      "pattern": "\\bEMP-\\d{6}\\b",
      "confidence": 0.9,
      "validator": "employeeIdChecksum",
      "examples": [
        "EMP-123455"
      ],
      "counterExamples": [
        "EMP-123456"
      ]
    },
    {
      "id": "badge-number",
      "name": "Badge number",
      "pattern": "(?:badge|工牌)\\s*(?:no\\.?|号)?\\s*[:：#]?\\s*(?<number>\\d{5})",
      "flags": "i",
      "group": "number",
      "confidence": 0.85,
      "examples": [
        "Badge: 40213",
        "工牌号：40213"
      ]
    },
    {
      "id": "salary",
      "name": "Salary",
      "pattern": "[$¥€£]\\s?\\d{1,3}(?:,\\d{3})+(?:\\.\\d{2})?",
      "confidence": 0.6,
      "contextKeywords": [
        "salary",
        "compensation",
        "base pay",
        "薪资",
        "工资",
        "年薪"
      ],
      "contextWindow": 30,
      "confidenceBoost": 1.5,
      "requireContext": true,
      "excludeKeywords": [
        "price",
        "total",
        "价格"
      ],
      "examples": [
        "Base salary: $85,000"
      ],
      "counterExamples": [
        "Unit price: $85,000"
      ]
    }
  ],
  "validators": {
    "employeeIdChecksum": "(match) => {\n  // The last digit is the sum of the first five, mod 10\n  const digits = match.slice(4).split('').map(Number);\n  return digits.slice(0, 5).reduce((sum, d) => sum + d, 0) % 10 === digits[5];\n}"
  }
}
