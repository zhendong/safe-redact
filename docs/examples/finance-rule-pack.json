{
  "id": "example-finance",
  "name": "Financial records (English)",
  "version": "1.0.0",
  "description": "English-language rules. Internal account references, wire transfer IDs, SWIFT/BIC codes, loan numbers, and trading account identifiers. All examples are fictional.",
  "author": "SafeRedact",
  "rules": [
    {
      "id": "internal-account-ref",
      "name": "Account Reference",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:account[ \\t]+(?:no\\.?|number|ref(?:erence)?|id))[ \\t]*[:#][ \\t]*(?<acct>\\d{3}-\\d{4}-\\d{4})(?![\\p{L}\\p{N}_-])",
      "flags": "iu",
      "group": "acct",
      "entityType": "ID",
      "confidence": 0.9,
      "scripts": [
        "latin"
      ],
      "examples": [
        "Account No: 001-2345-6789",
        "Account reference: 100-0001-0001",
        "Account ID: 200-3456-7890"
      ],
      "counterExamples": [
        "Order No: 001-2345-6789",
        "Account No: 001-234-6789",
        "Account No: 001-2345-67890"
      ]
    },
    {
      "id": "wire-transfer-id",
      "name": "Wire Transfer ID",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:wire[ \\t]+(?:transfer[ \\t]+)?(?:id|ref(?:erence)?|no\\.?))[ \\t]*[:#][ \\t]*(?<wire>WT\\d{12})(?![\\p{L}\\p{N}_-])",
      "flags": "iu",
      "group": "wire",
      "entityType": "ID",
      "confidence": 0.9,
      "scripts": [
        "latin"
      ],
      "examples": [
        "Wire Transfer ID: WT202611210001",
        "Wire ref: WT202611210002",
        "Wire no: WT202611210003"
      ],
      "counterExamples": [
        "Tracking ID: WT202611210001",
        "Wire Transfer ID: WT20261121000",
        "Wire Transfer ID: WT2026112100010"
      ]
    },
    {
      "id": "swift-bic",
      "name": "SWIFT/BIC Code",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:SWIFT|BIC)[ \\t]*(?:code)?[ \\t]*[:]?[ \\t]*(?<swift>[A-Z]{6}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)(?![\\p{L}\\p{N}_-])",
      "flags": "u",
      "group": "swift",
      "entityType": "ID",
      "confidence": 0.85,
      "scripts": [
        "latin"
      ],
      "examples": [
        "SWIFT: BOFAUS3N",
        "BIC code: CHASUS33XXX",
        "SWIFT: DEUTDEFF"
      ],
      "counterExamples": [
        "Code: BOFAUS3N",
        "SWIFT: BOF",
        "SWIFT: BOFAUS3N1234"
      ]
    },
    {
      "id": "loan-number",
      "name": "Loan Number",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:loan[ \\t]+(?:no\\.?|number|id|ref(?:erence)?)|mortgage[ \\t]+(?:no\\.?|number|id))[ \\t]*[:#][ \\t]*(?<loan>LN-\\d{4}-\\d{6})(?![\\p{L}\\p{N}_-])",
      "flags": "iu",
      "group": "loan",
      "entityType": "ID",
      "confidence": 0.9,
      "scripts": [
        "latin"
      ],
      "examples": [
        "Loan No: LN-2026-012345",
        "Mortgage number: LN-2026-098765",
        "Loan ref: LN-2026-054321"
      ],
      "counterExamples": [
        "Policy No: LN-2026-012345",
        "Loan No: LN-2026-12345",
        "Loan No: LN-2026-012345-A"
      ]
    },
    {
      "id": "trading-account",
      "name": "Trading Account",
      "pattern": "(?<![\\p{L}\\p{N}_])(?:trading[ \\t]+(?:account|acct)[ \\t]*(?:no\\.?|number|id)?|brokerage[ \\t]+(?:account|acct))[ \\t]*[:#][ \\t]*(?<trading>[A-Z]{2}\\d{8})(?![\\p{L}\\p{N}_-])",
      "flags": "iu",
      "group": "trading",
      "entityType": "ID",
      "confidence": 0.85,
      "scripts": [
        "latin"
      ],
      "examples": [
        "Trading Account: TD12345678",
        "Brokerage account: MS98765432",
        "Trading acct no: FD11223344"
      ],
      "counterExamples": [
        "Client code: TD12345678",
        "Trading Account: TD1234567",
        "Trading Account: TD123456789"
      ]
    }
  ]
}
